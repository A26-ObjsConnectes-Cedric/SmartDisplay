                  "icon": "cloud-upload",
                  "text": "Submit",
                  "variant": "primary"
                },
                "sync": false,
                "update": {
                  "code": "// Business Forms - panneau \"Envoyer un message\" : code de la requête de mise à jour (Update request > Code)\n// Éléments du formulaire (ids exacts) : api_key (mot de passe), text (texte), type (info | alert)\n// La clé API est saisie par l'utilisateur et n'est jamais enregistrée dans le tableau de bord.\nconst NODERED_URL = 'http://146.190.242.159:3001'; // à adapter (adresse du VPS, port Node-RED)\n\n// Valeurs saisies : le plugin les expose dans context.panel.elements (repli : options.elements)\nconst elements = (context.panel.elements && context.panel.elements.length)\n  ? context.panel.elements\n  : context.panel.options.elements;\nconst body = {};\nelements.forEach((element) => {\n  body[element.id] = element.value;\n});\n\nif (!body.api_key) {\n  console.error('SmartDisplay : clé API vide');\n  return;\n}\n\nfetch(`${NODERED_URL}/smartdisplay/cmd`, {\n  method: 'POST',\n  headers: {\n    'Content-Type': 'application/json',\n    'x-api-key': body.api_key,\n  },\n  body: JSON.stringify({ text: body.text, type: body.type }),\n})\n  .then((resp) => resp.json().then((data) => console.log('SmartDisplay', resp.status, data)))\n  .catch((error) => console.error('SmartDisplay', error));",
                  "confirm": false,
                  "contentType": "application/json",
                  "datasource": "ag3tjzvfyng8wd",
                  "getPayload": "const payload = {};\ncontext.panel.elements.forEach((element) => {\n  if (!element.value) {\n    return;\n  }\n  payload[element.id] = element.value;\n})\nreturn payload;",
                  "method": "-",
                  "payload": {},
                  "payloadMode": "all"
                },
                "updateEnabled": "auto"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
